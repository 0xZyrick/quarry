# Option A (quick dev): public key only. Anyone with the key can join any room.
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# Option B (recommended): token auth through /api/liveblocks-auth. Leave the public key empty.
NEXT_PUBLIC_LIVEBLOCKS_AUTH=1
LIVEBLOCKS_SECRET_KEY=   # sk_dev_... (server only, never prefix with NEXT_PUBLIC_)

# Leave both options empty to use the simulated creators.

# LiveKit (real cameras in the Commons Room). Leave empty to keep the mock tile video.
NEXT_PUBLIC_LIVEKIT_URL=   # wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Server enforcement (phase 25) ----
SESSION_SECRET=            # REQUIRED in production: long random string that signs the session cookie

# Supabase Auth email OTP (configure email OTP + SMTP in Supabase Auth settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Trust and safety (phase 26) ----
MODERATOR_UIDS=            # comma-separated account ids that can use /mod and /api/mod
SAFETY_MIN_AGE_MS=         # reports from accounts younger than this weigh 0 (default 600000 = 10 min)
SAFETY_MIN_DWELL_MS=       # a reporter must have been in the room this long (default 30000). Severe reports skip it


# ---- Invite-only entry (phase 28) ----
INVITE_CODES=              # comma-separated invite codes. Empty = the built-in test code QUARRY-ALPHA-27 works. Set this in production.

DATABASE_URL=              # postgresql://user:pass@localhost:5432/quarry
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN= # PostHog project token (phc_...)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
