generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

// ─── Core social + narrative models ─────────────────────────────────────────

model User {
  id          String   @id
  handle      String?  @unique
  email       String?  @unique
  accountTrack String?
  displayName String?
  bio         String?
  avatarUrl   String?
  gender      String?  // male | female — simple avatar seed
  interests   String[] @default([])
  levelTrack  String   @default("rising_craftsman")
  studioUnlocked Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects      Project[]
  contributions Contribution[]
  projectFollows ProjectFollow[]

  // Person graph
  following UserFollow[] @relation("UserFollowing")
  followers UserFollow[] @relation("UserFollowers")
}

model PendingEmailAuth {
  id           String   @id @default(cuid())
  email        String   @unique
  handle       String   @unique
  accountTrack String
  linkUid      String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Project {
  id              String        @id @default(uuid())
  creatorId       String
  creator         User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  intentStatement String
  coverImageUrl   String?
  currentState    String?
  nextStep        String?
  status          ProjectStatus @default(IN_PROGRESS)
  visibility      ProjectVisibility @default(PUBLIC)
  zoneId          String?           // forge | atelier | arcade | commons | bay | shed
  /// Stack / craft tags (auto-feed profile skills)
  tags            String[]          @default([])
  journeyNodes    JourneyNode[]
  workSessions    WorkSession[]
  followers       ProjectFollow[]
  helpRequests    HelpRequest[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([visibility])
  @@index([zoneId])
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum ProjectVisibility {
  PUBLIC
  CIRCLE
  PRIVATE
}

model JourneyNode {
  id              String         @id @default(uuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position        Int
  dayLabel        String
  phaseTitle      String
  updateTitle     String?
  summaryText     String
  prevSnapshotUrl String?
  nextSnapshotUrl String?
  evolutionDelta  String?
  /// External live URL pasted by creator (Twitch / YouTube Live) — never streamed by Wippo
  liveUrl         String?
  /// Platform of liveUrl: twitch | youtube | other
  livePlatform    String?
  /// Archived VOD URL resolved after session ends
  vodUrl          String?
  /// How this update should surface on profile "how they think"
  updateKind      UpdateKind     @default(MILESTONE)
  /// LLM / helper prompt used during this stop (optional)
  promptUsed      String?
  /// Tools tagged on this update (Figma, Claude, Three.js, …)
  tools           String[]       @default([])
  /// Still images for this update (max enforced in API)
  imageUrls       String[]       @default([])
  sessionStartedAt DateTime?
  sessionEndedAt   DateTime?
  mediaDrops      MediaDrop[]
  discussions     Contribution[]
  workSessions    WorkSession[]
  triedAttempts   TriedAttempt[]
  helpRequests    HelpRequest[]
  createdAt       DateTime       @default(now())

  @@index([projectId, position])
  @@index([sessionEndedAt])
}

model MediaDrop {
  id             String      @id @default(uuid())
  journeyNodeId  String
  journeyNode    JourneyNode @relation(fields: [journeyNodeId], references: [id], onDelete: Cascade)
  type           DropType
  videoUrl       String
  durationSecs   Int
  decisionMetric String?
  tag            String?
  isLiveExtract  Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([journeyNodeId])
}

enum UpdateKind {
  MILESTONE
  DEAD_END
  DECISION
  PARTIAL
}

enum DropType {
  STREAM_VOD_7DAY
  PERMANENT_TEASE
}

model Contribution {
  id             String      @id @default(uuid())
  journeyNodeId  String
  journeyNode    JourneyNode @relation(fields: [journeyNodeId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ActionType
  messageText    String
  isPinnedByHost Boolean     @default(false)
  /// Host marked this helper's contribution as useful → shows on helper profile
  markedHelpful  Boolean     @default(false)
  markedHelpfulAt DateTime?
  createdAt      DateTime    @default(now())

  @@index([journeyNodeId])
  @@index([userId])
  @@index([markedHelpful, userId])
}

enum ActionType {
  SUGGESTION
  CRITIQUE
  ENCOURAGEMENT
}

model WorkSession {
  id           String            @id @default(uuid())
  creatorId    String
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  journeyNodeId String?
  journeyNode  JourneyNode?      @relation(fields: [journeyNodeId], references: [id], onDelete: SetNull)
  title        String
  goal         String?
  currentState String?
  nextStep     String?
  visibility   SessionVisibility @default(PUBLIC)
  mode         SessionMode       @default(LIVE)
  roomId       String?
  /// Pasted Twitch / YouTube Live URL for iframe embed
  liveUrl      String?
  livePlatform String?
  /// Filled when session ends (API / job)
  vodUrl       String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  endedAt      DateTime?

  @@index([creatorId])
  @@index([projectId])
  @@index([journeyNodeId])
  @@index([visibility, isActive])
  @@index([roomId])
}

enum SessionVisibility {
  PUBLIC
  PRIVATE
}

enum SessionMode {
  LIVE
  RECORDED
  PROGRESS_UPDATE
}

/// One row per ended session — powers Last 12 Weeks activity grid (date only)
model SessionShip {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  nodeId    String?
  /// UTC day bucket YYYY-MM-DD for cheap range queries
  dayKey    String
  createdAt DateTime @default(now())

  @@index([userId, dayKey])
  @@index([userId, createdAt])
}


/// Explicit outcome rows on an update (Dead end / Partial / Worked)
model TriedAttempt {
  id            String       @id @default(uuid())
  journeyNodeId String
  journeyNode   JourneyNode  @relation(fields: [journeyNodeId], references: [id], onDelete: Cascade)
  outcome       TriedOutcome
  detail        String
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([journeyNodeId])
}

enum TriedOutcome {
  DEAD_END
  PARTIAL
  WORKED
  ARTIFACT
}

/// Open ask for help on a project (and optional node)
model HelpRequest {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeId      String?
  journeyNode JourneyNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  /// Room / update this ask is bound to (dies when host leaves that room)
  roomId      String?
  sessionId   String?
  creatorId   String
  title       String
  body        String?
  tags        String[]         @default([])
  status      HelpRequestStatus @default(OPEN)
  /// Legacy single claimer (kept for old rows)
  claimedById String?
  claimedAt   DateTime?
  /// Users waiting for host accept
  pendingIds  String[]         @default([])
  /// Accepted co-team for this update (max 3)
  acceptedIds String[]         @default([])
  createdAt   DateTime         @default(now())
  closedAt    DateTime?

  @@index([projectId, status])
  @@index([status, createdAt])
  @@index([creatorId])
  @@index([roomId, status])
}

enum HelpRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Lightweight presence in a live room (projectId / roomId)
model RoomPresence {
  id         String   @id @default(uuid())
  roomId     String
  userId     String
  handle     String?
  lastSeenAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId, lastSeenAt])
}

/// Circle: user follows a project (progress stream)
model ProjectFollow {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

/// Social graph: user follows a person
model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ─── Messaging + notifications ──────────────────────────────────────────────

model Conversation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // circle_update | follow | message | contribute
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  meta      String?  // JSON blob
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

/// Optional: which zone a user calls home (continuity)
model UserHome {
  userId    String   @id
  zoneId    String
  updatedAt DateTime @updatedAt
}

// ─── Spatial registry (rooms, crew, hub live state) ─────────────────────────
// Durable replacement for the in-memory Maps in lib/server/registry.ts

model GuildRoom {
  id        String   @id // n0…n13 | own:<suffix>
  type      String // commons | war
  ownerUid  String?
  handle    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crew GuildCrewMember[]
  hub  GuildHub?

  @@index([ownerUid])
  @@index([handle])
}

model GuildCrewMember {
  roomId    String
  uid       String
  createdAt DateTime @default(now())

  room GuildRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, uid])
  @@index([uid])
}

model GuildHub {
  roomId     String   @id
  live       Boolean  @default(false)
  suspended  Boolean  @default(false)
  greenroom  Boolean  @default(false)
  /// Gate: canvas source (Figma, VS Code, …) and/or skill tag
  gateCanvas String?
  gateSkill  String?
  /// Launch Portal meta
  metaTitle  String?
  metaTags   String[] @default([])
  metaEnv    String? // sandbox | focus
  metaPath   String? // digital | physical
  metaZone   String?
  /// Account ids that currently contribute weight to the flag count
  flagUids   String[] @default([])
  updatedAt  DateTime @updatedAt

  room GuildRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

/// Display-name claims used by the spatial map (demo nodes + user handles)
model GuildHandle {
  handle    String   @id
  uid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uid])
}

// ─── Trust & safety (durable cases, bans, mutes, audit) ─────────────────────

model SafetyCase {
  id             String    @id @default(cuid())
  kind           String // stream | user
  roomId         String
  ownerUid       String?
  target         String? // handle for user-kind reports
  reasons        String[]  @default([])
  severe         Boolean   @default(false)
  state          String // open | upheld | dismissed | appealed | reinstated | expired
  held           Boolean   @default(false)
  restoreAt      DateTime?
  appealText     String?
  appealAt       DateTime?
  decisionBy     String?
  decisionAt     DateTime?
  decisionAction String?
  decisionNote   String?
  openedAt       DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reporters SafetyReport[]

  @@index([roomId, state])
  @@index([state, severe])
  @@index([ownerUid])
  @@index([restoreAt])
}

model SafetyReport {
  id        String     @id @default(cuid())
  caseId    String
  case      SafetyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uid       String
  reason    String
  weight    Float
  createdAt DateTime   @default(now())

  @@unique([caseId, uid])
  @@index([uid, createdAt])
}

model AccountBan {
  uid       String    @id
  until     DateTime? // null = permanent
  reason    String
  by        String
  createdAt DateTime  @default(now())
}

model AccountStrike {
  uid       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RoomMute {
  roomId    String
  uid       String
  createdAt DateTime @default(now())

  @@id([roomId, uid])
  @@index([uid])
}

model RoomBan {
  roomId    String
  uid       String
  createdAt DateTime @default(now())

  @@id([roomId, uid])
  @@index([uid])
}

model ReporterStats {
  uid       String @id
  upheld    Int    @default(0)
  dismissed Int    @default(0)
}

model SafetyAudit {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  by     String
  action String
  detail Json?

  @@index([at])
}

/// First time the server saw this account (for report weight / throwaway filter)
model AccountSeen {
  uid       String   @id
  firstSeen DateTime @default(now())
}

/// First moment an account was inside a room (dwell gate for reports)
model RoomDwell {
  roomId    String
  uid       String
  enteredAt DateTime @default(now())

  @@id([roomId, uid])
}

// ─── Room chat (messages + mic state) ───────────────────────────────────────

model ChatMessage {
  id        String   @id
  roomId    String
  kind      String // text | system
  by        String // handle or "system"
  uid       String? // account that sent it (null for system)
  text      String
  question  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

/// Current mic queue and open slots for a room (single row per room)
model ChatMicState {
  roomId    String   @id
  /// Handles waiting for the mic
  requests  String[] @default([])
  /// Handles currently holding a mic slot (max 2)
  slots     String[] @default([])
  updatedAt DateTime @updatedAt
}

/// handle → uid mapping observed in a room (for moderation actions)
model ChatHandle {
  roomId String
  handle String
  uid    String
  updatedAt DateTime @updatedAt

  @@id([roomId, handle])
  @@index([roomId, uid])
}
